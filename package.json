{
  "name": "metacat",
  "version": "0.1.6-alpha",
  "license": "AGPL-3.0-only",
  "description": "A full CRUD DataCite Metadata catalog backend service",
  "keywords": [
    "DataCite",
    "Metadata",
    "Catalog",
    "CRUD",
    "API",
    "Express",
    "NodeJS",
    "MongoDB",
    "Mongoose"
  ],
  "homepage": "https://github.com/fpistagna/metacat",
  "author": {
    "name": "Fabrizio Pistagna",
    "email": "fabrizio.pistagna@ingv.it",
    "url": "https://github.com/fpistagna"
  },
  "main": "./src/server.js",
  "scripts": {
    "dev": "nodemon ./src/server.js",
    "start": "node ./src/server.js",
    "test": "npm run test:safety && npm run test:schemas && npm run test:server && npm run test:auth && npm run test:record && npm run test:user && npm run test:migration:user",
    "test:safety": "mocha -r dotenv/config ./test/testDatabase.test.js",
    "test:schemas": "mocha -r dotenv/config ./test/schemas.test.js",
    "test:server": "mocha -r dotenv/config ./test/server.test.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "test:record": "mocha --timeout 10000 -r dotenv/config ./test/record.js",
    "test:auth": "mocha --timeout 10000 -r dotenv/config ./test/auth.test.js",
    "test:user": "mocha --timeout 10000 -r dotenv/config ./test/user.test.js",
    "test:migration:user": "mocha --timeout 10000 -r dotenv/config ./test/migrations.user.test.js",
    "migrate:create": "node scripts/migrate.js create",
    "migrate:up": "node scripts/migrate.js up",
    "migrate:down": "node scripts/migrate.js down",
    "validate:json": "node scripts/validate-json.js",
    "transform:json": "node scripts/transform-json.js",
    "db:seed": "node scripts/seed-database.js",
    "error": "echo \"Error: no test specified\" && exit 1",
    "ajv": "node ajv.js"
  },
  "dependencies": {
    "ajv": "^8.13.0",
    "ajv-formats": "^3.0.1",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "body-parser": "^1.20.2",
    "dotenv": "^17.2.1",
    "express": "^4.19.2",
    "express-json-validator-middleware": "^3.0.1",
    "express-response-helper": "^1.3.1",
    "express-validator": "^7.1.0",
    "generate-schema": "^2.6.0",
    "jsonpatch": "^3.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "mongoose-paginate-v2": "^1.9.1",
    "morgan": "^1.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "umzug": "^3.8.2",
    "uuid": "^14.0.2",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "chai": "^4.4.1",
    "chai-http": "^4.4.0",
    "mocha": "^8.1.3",
    "nodemon": "^3.1.10"
  }
}
