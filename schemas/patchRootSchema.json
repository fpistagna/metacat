{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "patchRootSchema#",
  "description": "Schema for partially updating a record's metadata. The attributes object is required and must contain at least one property.",
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "dois"
        },
        "attributes": {
          "type": "object",
          "properties": {
            "doi": {
              "$ref": "doi#"
            },
            "identifiers": {
              "$ref": "identifiers#"
            },
            "creators": {
              "$ref": "creators#"
            },
            "titles": {
              "$ref": "titles#"
            },
            "publisher": {
              "$ref": "publisher#"
            },
            "publicationYear": {
              "$ref": "publicationYear#"
            },
            "subjects": {
              "$ref": "subjects#"
            },
            "contributors": {
              "$ref": "contributors#"
            },
            "dates": {
              "$ref": "dates#"
            },
            "resourceType": {
              "$ref": "resourceType#"
            },
            "descriptions": {
              "$ref": "descriptions#"
            },
            "geoLocations": {
              "$ref": "geoLocations#"
            },
            "fundingReferences": {
              "$ref": "fundingReferences#"
            },
            "formats": {
              "$ref": "formats#"
            },
            "sizes": {
              "$ref": "sizes#"
            },
            "language": {
              "$ref": "language#"
            }
          },
          "minProperties": 1
        }
      },
      "required": [
        "attributes"
      ]
    }
  },
  "required": [
    "metadata"
  ]
}
